{
  "name": "pi-trackio",
  "version": "0.1.0",
  "description": "Self-hosted Trackio experiment tracking for Pi: native interactive charts and live Trackio dashboard embedded in pi-web, replacing Weights & Biases (W&B) with online SQLite + GCS backups.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "trackio",
    "wandb",
    "experiment-tracking",
    "metrics",
    "pi-web"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test test/trackio.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0"
  }
}
